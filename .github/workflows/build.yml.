name: Build APK
on:
  workflow_dispatch:
  push:
    branches: [main]
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7
      - name: Create project files
        run: |
          mkdir -p $(dirname settings.gradle.kts)
          cat > settings.gradle.kts <<'MACTV_EOF'
          pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }
          dependencyResolutionManagement { repositories { google(); mavenCentral() } }
          rootProject.name = "MacTV"
          include(":app")
          MACTV_EOF
          mkdir -p $(dirname build.gradle.kts)
          cat > build.gradle.kts <<'MACTV_EOF'
          plugins {
              id("com.android.application") version "8.5.2" apply false
              id("org.jetbrains.kotlin.android") version "1.9.24" apply false
          }
          MACTV_EOF
          mkdir -p $(dirname gradle.properties)
          cat > gradle.properties <<'MACTV_EOF'
          android.useAndroidX=true
          org.gradle.jvmargs=-Xmx2g
          MACTV_EOF
          mkdir -p $(dirname app/build.gradle.kts)
          cat > app/build.gradle.kts <<'MACTV_EOF'
          plugins { id("com.android.application"); id("org.jetbrains.kotlin.android") }
          android {
              namespace = "com.mactv.app"
              compileSdk = 34
              defaultConfig { applicationId = "com.mactv.app"; minSdk = 24; targetSdk = 34; versionCode = 1; versionName = "1.0" }
              compileOptions { sourceCompatibility = JavaVersion.VERSION_17; targetCompatibility = JavaVersion.VERSION_17 }
              kotlinOptions { jvmTarget = "17" }
          }
          dependencies {
              implementation("androidx.media3:media3-exoplayer:1.3.1")
              implementation("androidx.media3:media3-exoplayer-hls:1.3.1")
              implementation("androidx.media3:media3-ui:1.3.1")
          }
          MACTV_EOF
          mkdir -p $(dirname app/src/main/AndroidManifest.xml)
          cat > app/src/main/AndroidManifest.xml <<'MACTV_EOF'
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
              <uses-permission android:name="android.permission.INTERNET" />
              <application android:label="Mac TV" android:usesCleartextTraffic="true"
                  android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
                  <activity android:name=".MainActivity" android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                  </activity>
                  <activity android:name=".PlayerActivity"
                      android:configChanges="orientation|screenSize|keyboardHidden" />
              </application>
          </manifest>
          MACTV_EOF
          mkdir -p $(dirname app/src/main/java/com/mactv/app/MainActivity.kt)
          cat > app/src/main/java/com/mactv/app/MainActivity.kt <<'MACTV_EOF'
          package com.mactv.app

          import android.app.Activity
          import android.content.Intent
          import android.os.Bundle
          import android.webkit.JavascriptInterface
          import android.webkit.WebView
          import org.json.JSONObject
          import java.net.HttpURLConnection
          import java.net.URL

          const val UA = "Mozilla/5.0 (QtEmbedded; U; Linux; C) AppleWebKit/533.3 (KHTML, like Gecko) MAG200 stbapp ver: 2 rev: 250 Safari/533.3"

          class MainActivity : Activity() {
              private lateinit var web: WebView

              override fun onCreate(b: Bundle?) {
                  super.onCreate(b)
                  web = WebView(this)
                  setContentView(web)
                  web.settings.javaScriptEnabled = true
                  web.settings.domStorageEnabled = true
                  web.addJavascriptInterface(Bridge(), "Android")
                  web.loadUrl("file:///android_asset/index.html")
              }

              inner class Bridge {
                  @JavascriptInterface
                  fun request(id: Int, url: String, mac: String, token: String) {
                      Thread {
                          var out = ""
                          try {
                              val c = URL(url).openConnection() as HttpURLConnection
                              c.connectTimeout = 15000
                              c.readTimeout = 20000
                              c.setRequestProperty("User-Agent", UA)
                              c.setRequestProperty("X-User-Agent", "Model: MAG250; Link: WiFi")
                              c.setRequestProperty("Cookie", "mac=$mac; stb_lang=en; timezone=GMT")
                              if (token.isNotEmpty()) c.setRequestProperty("Authorization", "Bearer $token")
                              out = c.inputStream.bufferedReader().readText()
                          } catch (e: Exception) { }
                          runOnUiThread { web.evaluateJavascript("onNative($id,${JSONObject.quote(out)})", null) }
                      }.start()
                  }

                  @JavascriptInterface
                  fun play(url: String) {
                      startActivity(Intent(this@MainActivity, PlayerActivity::class.java).putExtra("u", url))
                  }
              }
          }
          MACTV_EOF
          mkdir -p $(dirname app/src/main/java/com/mactv/app/PlayerActivity.kt)
          cat > app/src/main/java/com/mactv/app/PlayerActivity.kt <<'MACTV_EOF'
          package com.mactv.app

          import android.app.Activity
          import android.os.Bundle
          import android.view.WindowManager
          import androidx.media3.common.MediaItem
          import androidx.media3.datasource.DefaultHttpDataSource
          import androidx.media3.exoplayer.ExoPlayer
          import androidx.media3.exoplayer.source.DefaultMediaSourceFactory
          import androidx.media3.ui.PlayerView

          class PlayerActivity : Activity() {
              private var player: ExoPlayer? = null

              override fun onCreate(b: Bundle?) {
                  super.onCreate(b)
                  window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
                  val view = PlayerView(this)
                  setContentView(view)
                  val http = DefaultHttpDataSource.Factory().setUserAgent(UA).setAllowCrossProtocolRedirects(true)
                  player = ExoPlayer.Builder(this).setMediaSourceFactory(DefaultMediaSourceFactory(http)).build().also {
                      view.player = it
                      it.setMediaItem(MediaItem.fromUri(intent.getStringExtra("u") ?: ""))
                      it.prepare()
                      it.playWhenReady = true
                  }
              }

              override fun onDestroy() { player?.release(); super.onDestroy() }
          }
          MACTV_EOF
          mkdir -p $(dirname app/src/main/assets/index.html)
          cat > app/src/main/assets/index.html <<'MACTV_EOF'
          <!DOCTYPE html><html><head><meta charset="utf-8">
          <meta name="viewport" content="width=device-width,initial-scale=1">
          <style>
          :root{--bg:#10151c;--panel:#18202b;--line:#263243;--text:#e8edf3;--mute:#8a98aa;--accent:#2ec4b6}
          *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px system-ui,sans-serif}
          input{width:100%;padding:12px;margin:0 0 10px;background:var(--panel);border:1px solid var(--line);border-radius:8px;color:var(--text);font:inherit}
          button{width:100%;padding:12px;background:var(--accent);color:#06201d;border:0;border-radius:8px;font:inherit;font-weight:600}
          #setup,#top{padding:16px}h1{font-size:22px;margin:0 0 4px}p{color:var(--mute);margin:0 0 16px}
          #app{display:none}#top{position:sticky;top:0;background:var(--bg);display:flex;gap:8px}#top input{margin:0}#top button{width:auto}
          .ch{padding:12px 16px;border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:center}
          .ch img{width:34px;height:34px;object-fit:contain}.ch:active{background:var(--panel)}
          #err{color:#ff8a80;margin-top:10px}
          </style></head><body>
          <div id="setup"><h1>Mac TV</h1><p>Enter your own portal details. They stay on this phone.</p>
          <input id="portal" placeholder="Portal URL, e.g. http://host/c/">
          <input id="mac" placeholder="MAC address, e.g. 00:1A:79:xx:xx:xx">
          <button id="go">Connect</button><div id="err"></div></div>
          <div id="app"><div id="top"><input id="q" placeholder="Search channels"><button id="out">Settings</button></div><div id="list"></div></div>
          <script>
          const $=i=>document.getElementById(i);let cbs={},seq=0,host,mac,base,token="",all=[];
          const PATHS=["/portal.php","/stalker_portal/server/load.php","/server/load.php","/c/server/load.php"];
          window.onNative=(id,t)=>{cbs[id](t);delete cbs[id]};
          const req=(u,t)=>new Promise(r=>{const id=++seq;cbs[id]=r;Android.request(id,u,mac,t||"")});
          async function call(p,q,t){const u=host+p+"?"+new URLSearchParams({...q,JsHttpRequest:"1-xml"});
          const x=await req(u,t);try{return JSON.parse(x)}catch{return null}}
          async function connect(){
           $("err").textContent="Connecting...";
           try{host=new URL($("portal").value.trim()).origin}catch{$("err").textContent="Enter a valid portal URL.";return}
           mac=$("mac").value.trim().toUpperCase();
           if(!/^([0-9A-F]{2}:){5}[0-9A-F]{2}$/.test(mac)){$("err").textContent="MAC format is wrong.";return}
           base=null;token="";
           for(const p of PATHS){const j=await call(p,{type:"stb",action:"handshake",token:""});
            if(j&&j.js&&j.js.token){base=p;token=j.js.token;break}}
           if(!base){$("err").textContent="Could not connect. Check portal URL, MAC and subscription.";return}
           await call(base,{type:"stb",action:"get_profile"},token);
           const c=await call(base,{type:"itv",action:"get_all_channels"},token);
           if(!c||!c.js||!c.js.data){$("err").textContent="No channels returned. Subscription may be inactive.";return}
           all=c.js.data;localStorage.p=$("portal").value.trim();localStorage.m=mac;
           $("setup").style.display="none";$("app").style.display="block";draw();
          }
          function draw(){const f=$("q").value.toLowerCase(),b=$("list");b.innerHTML="";
           all.filter(c=>c.name.toLowerCase().includes(f)).slice(0,400).forEach(c=>{
            const d=document.createElement("div");d.className="ch";
            if(c.logo&&/^http/.test(c.logo)){const i=document.createElement("img");i.src=c.logo;i.onerror=()=>i.remove();d.append(i)}
            const s=document.createElement("span");s.textContent=c.name;d.append(s);
            d.onclick=()=>play(c);b.append(d)})}
          async function play(c){
           const j=await call(base,{type:"itv",action:"create_link",cmd:c.cmd,series:"",forced_storage:"undefined",disable_ad:"0",download:"0"},token);
           const u=((j&&j.js&&j.js.cmd)||"").replace(/^\S+\s+(?=http)/,"");
           if(u)Android.play(u);else alert("Could not get stream for "+c.name);}
          $("go").onclick=connect;$("q").oninput=draw;
          $("out").onclick=()=>{$("app").style.display="none";$("setup").style.display="block"};
          if(localStorage.p){$("portal").value=localStorage.p;$("mac").value=localStorage.m||""}
          </script></body></html>
          MACTV_EOF
      - name: Build debug APK
        run: gradle assembleDebug --no-daemon
      - name: Publish APK
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release create "v${{ github.run_number }}" app/build/outputs/apk/debug/app-debug.apk --title "Mac TV build ${{ github.run_number }}" --notes "Debug APK"
